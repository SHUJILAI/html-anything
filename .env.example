# Copy this to .env and fill in real values. .env is gitignored.

# Required: OpenRouter-compatible gateway
AI_GATEWAY_BASE_URL=https://your-gateway.example.com
AI_GATEWAY_API_KEY=sk-...

# Recommended: protect /api/generate, /api/share, /admin/* with a shared token.
# The frontend collects this from the user via the 🔑 Token button and sends it as
# the x-ha-token header. Leave unset to disable auth (dev mode only).
ACCESS_TOKEN=change-me-to-a-long-random-string

# Optional overrides
# HA_MODEL=anthropic/claude-sonnet-4.6
# MAX_CONTENT_CHARS=50000
# PORT=8080
